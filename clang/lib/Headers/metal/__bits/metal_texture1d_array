  METAL_FUNC T sample(sampler s, float2 coord, level optionsuint array_index, int2 offset = int2(0)) const thread { return __metal_sample_texture1d_array_t(this->t, s.val, coord, true, offset, true, options.lod, 0.0f, int(this->a), nullptr, T()); }
