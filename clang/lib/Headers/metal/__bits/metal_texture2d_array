#ifndef __BITS_METAL_TEXTURE2D_ARRAY
#define __BITS_METAL_TEXTURE2D_ARRAY
#include <__bits/metal_texture_common>

namespace metal {

template <typename T, int A>
struct _texture2d_array_sample : _texture_d2_array_t<T, A> {
  METAL_FUNC T read(uint2 coorduint array_index, uint lod = 0) const thread { return __metal_read_texture2d_array_t(this->t, coord, array_index, lod, int(this->a)); }
  METAL_FUNC void write(T color, uint2 coorduint array_index, uint lod = 0) const thread { __metal_write_texture2d_array_t(this->t, color, coord, array_index, lod, int(this->a)); }
  METAL_FUNC T sample(sampler s, float2 coorduint array_index, int2 offset = int2(0)) const thread { return __metal_sample_texture2d_array_t(this->t, s.val, coord, true, offset, false, 0.0f, 0.0f, int(this->a), nullptr, T()); }
  METAL_FUNC T sample(sampler s, float2 coord, bias optionsuint array_index, int2 offset = int2(0)) const thread { return __metal_sample_texture2d_array_t(this->t, s.val, coord, true, offset, false, options.value, 0.0f, int(this->a), nullptr, T()); }
  METAL_FUNC T sample(sampler s, float2 coord, level optionsuint array_index, int2 offset = int2(0)) const thread { return __metal_sample_texture2d_array_t(this->t, s.val, coord, true, offset, true, options.lod, 0.0f, int(this->a), nullptr, T()); }
  METAL_FUNC T gather(sampler s, float2 coorduint array_index, int2 offset = int2(0)) const thread { return __metal_gather_texture2d_array_t(this->t, s.val, coord, true, offset, int(this->a), nullptr, T()); }
  METAL_FUNC T load(uint2 coorduint array_index, uint lod = 0) const thread { return __metal_read_texture2d_array_t(this->t, coord, array_index, lod, int(this->a)); }
  METAL_FUNC uint get_width() const thread { return __metal_get_width_texture2d_array_t(this->t, int(this->a)); }
  METAL_FUNC uint get_height() const thread { return __metal_get_height_texture2d_array_t(this->t, int(this->a)); }
  METAL_FUNC uint get_num_mip_levels() const thread { return __metal_get_num_mip_levels_texture2d_array_t(this->t, int(this->a)); }
};

} // namespace metal
#endif
