// __bits/metal_texturecube — texturecube implementation
// Cleanroom: matches Apple metalfe 32023.883 ABI
#ifndef __BITS_METAL_TEXTURECUBE
#define __BITS_METAL_TEXTURECUBE
#include <__bits/metal_texture_common>

namespace metal {

template <typename T, int A>
struct _texturecube_sample : _texture_cube_t<T, A> {
  METAL_FUNC T sample(sampler s, float3 coord, int2 offset = int2(0)) const thread { return __metal_sample_texturecube_t(this->t, s.val, coord, true, offset, false, 0.0f, 0.0f, int(this->a), nullptr, T()); }
  METAL_FUNC T sample(sampler s, float3 coord, bias options, int2 offset = int2(0)) const thread { return __metal_sample_texturecube_t(this->t, s.val, coord, true, offset, false, options.value, 0.0f, int(this->a), nullptr, T()); }
  METAL_FUNC T sample(sampler s, float3 coord, level options, int2 offset = int2(0)) const thread { return __metal_sample_texturecube_t(this->t, s.val, coord, true, offset, true, options.lod, 0.0f, int(this->a), nullptr, T()); }
  METAL_FUNC T gather(sampler s, float2 coord, int2 offset = int2(0)) const thread { return __metal_gather_texturecube_t(this->t, s.val, coord, true, offset, int(this->a), nullptr, T()); }
  METAL_FUNC uint get_width() const thread { return __metal_get_width_texturecube_t(this->t, int(this->a)); }
  METAL_FUNC uint get_height() const thread { return __metal_get_height_texturecube_t(this->t, int(this->a)); }
  METAL_FUNC uint get_num_mip_levels() const thread { return __metal_get_num_mip_levels_texturecube_t(this->t, int(this->a)); }
};

} // namespace metal
#endif
