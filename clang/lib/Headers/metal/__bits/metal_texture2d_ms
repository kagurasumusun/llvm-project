// __bits/metal_texture2d_ms — texture2d_ms implementation
// Cleanroom: matches Apple metalfe 32023.883 ABI
#ifndef __BITS_METAL_TEXTURE2D_MS
#define __BITS_METAL_TEXTURE2D_MS
#include <__bits/metal_texture_common>

namespace metal {

template <typename T, int A>
struct _texture2d_ms_sample : _texture_d2_ms_t<T, A> {
  METAL_FUNC T read(uint2 coord, uint lod = 0) const thread { return __metal_read_texture2d_ms_t(this->t, coord, lod, int(this->a)); }
  METAL_FUNC void write(T color, uint2 coord, uint lod = 0) const thread { __metal_write_texture2d_ms_t(this->t, color, coord, lod, int(this->a)); }
  METAL_FUNC T load(uint2 coord, uint lod = 0) const thread { return __metal_read_texture2d_ms_t(this->t, coord, lod, int(this->a)); }
  METAL_FUNC uint get_width() const thread { return __metal_get_width_texture2d_ms_t(this->t, int(this->a)); }
  METAL_FUNC uint get_height() const thread { return __metal_get_height_texture2d_ms_t(this->t, int(this->a)); }
  METAL_FUNC uint get_num_mip_levels() const thread { return __metal_get_num_mip_levels_texture2d_ms_t(this->t, int(this->a)); }
};

} // namespace metal
#endif
