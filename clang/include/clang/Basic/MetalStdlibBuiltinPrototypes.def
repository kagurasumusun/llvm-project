//===----------------------------------------------------------------------===//
//
// Bootstrap exact prototypes for a small common subset of __metal_* stdlib
// entry points.  These declarations supplement MetalStdlibBuiltins.def, whose
// remaining callable rows still use a generic fallback until a fuller Apple
// header signature extractor is wired in.
//
// METAL_STDLIB_BUILTIN_PROTO(Name, PrototypeString)
//
//===----------------------------------------------------------------------===//

#ifndef METAL_STDLIB_BUILTIN_PROTO
#define METAL_STDLIB_BUILTIN_PROTO(Name, PrototypeString)
#endif

METAL_STDLIB_BUILTIN_PROTO(__metal_abs, "extern \"C\" int __metal_abs(int);")
METAL_STDLIB_BUILTIN_PROTO(__metal_select, "extern \"C\" int __metal_select(int, int, bool);")

METAL_STDLIB_BUILTIN_PROTO(__metal_acos, "extern \"C\" float __metal_acos(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_asin, "extern \"C\" float __metal_asin(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_atan, "extern \"C\" float __metal_atan(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_ceil, "extern \"C\" float __metal_ceil(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_cos, "extern \"C\" float __metal_cos(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_exp, "extern \"C\" float __metal_exp(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_exp2, "extern \"C\" float __metal_exp2(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_floor, "extern \"C\" float __metal_floor(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_log, "extern \"C\" float __metal_log(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_log2, "extern \"C\" float __metal_log2(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_rsqrt, "extern \"C\" float __metal_rsqrt(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_sin, "extern \"C\" float __metal_sin(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_sqrt, "extern \"C\" float __metal_sqrt(float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_trunc, "extern \"C\" float __metal_trunc(float);")

METAL_STDLIB_BUILTIN_PROTO(__metal_clamp, "extern \"C\" float __metal_clamp(float, float, float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_fmax, "extern \"C\" float __metal_fmax(float, float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_fmin, "extern \"C\" float __metal_fmin(float, float);")
METAL_STDLIB_BUILTIN_PROTO(__metal_pow, "extern \"C\" float __metal_pow(float, float);")
