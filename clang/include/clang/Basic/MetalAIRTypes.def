//===----------------------------------------------------------------------===//
//
// This file is generated by clang/utils/metal/gen-metal-air-support.py.
//
// METAL_AIR_TYPE(Name, CType, AIRName, AIRItaniumMangle)
//
// Name is the Metal source spelling introduced by the lightweight Clang Metal
// prelude. CType is the C/C++ spelling used to declare that alias. AIRName is
// the type name normally printed in AIR metadata. AIRItaniumMangle is the
// Itanium-style fragment Apple AIR uses inside generated(...) IO names for the
// common scalar/vector types covered here.
//
//===----------------------------------------------------------------------===//

#ifndef METAL_AIR_TYPE
#error "Define METAL_AIR_TYPE before including MetalAIRTypes.def"
#endif

METAL_AIR_TYPE(uchar, "unsigned char", "uchar", "h")
METAL_AIR_TYPE(ushort, "unsigned short", "ushort", "t")
METAL_AIR_TYPE(uint, "unsigned int", "uint", "j")
METAL_AIR_TYPE(ulong, "unsigned long", "ulong", "m")
METAL_AIR_TYPE(half, "__fp16", "half", "Dh")

METAL_AIR_TYPE(float2, "float __attribute__((ext_vector_type(2)))", "float2", "Dv2_f")
METAL_AIR_TYPE(float3, "float __attribute__((ext_vector_type(3)))", "float3", "Dv3_f")
METAL_AIR_TYPE(float4, "float __attribute__((ext_vector_type(4)))", "float4", "Dv4_f")
METAL_AIR_TYPE(half2, "half __attribute__((ext_vector_type(2)))", "half2", "Dv2_Dh")
METAL_AIR_TYPE(half3, "half __attribute__((ext_vector_type(3)))", "half3", "Dv3_Dh")
METAL_AIR_TYPE(half4, "half __attribute__((ext_vector_type(4)))", "half4", "Dv4_Dh")
METAL_AIR_TYPE(int2, "int __attribute__((ext_vector_type(2)))", "int2", "Dv2_i")
METAL_AIR_TYPE(int3, "int __attribute__((ext_vector_type(3)))", "int3", "Dv3_i")
METAL_AIR_TYPE(int4, "int __attribute__((ext_vector_type(4)))", "int4", "Dv4_i")
METAL_AIR_TYPE(uint2, "uint __attribute__((ext_vector_type(2)))", "uint2", "Dv2_j")
METAL_AIR_TYPE(uint3, "uint __attribute__((ext_vector_type(3)))", "uint3", "Dv3_j")
METAL_AIR_TYPE(uint4, "uint __attribute__((ext_vector_type(4)))", "uint4", "Dv4_j")

// Matrix aliases are ABI placeholders for early parser/codegen bring-up.  They
// are deliberately not used for generated(...) mangling yet.
METAL_AIR_TYPE(float2x2, "float __attribute__((ext_vector_type(4)))", "float2x2", "")
METAL_AIR_TYPE(float4x4, "float __attribute__((ext_vector_type(16)))", "float4x4", "")
