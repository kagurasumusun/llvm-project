//===--- BuiltinsMetal.def - Metal builtin function database ----*- C++ -*-===//
//
// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
// See https://llvm.org/LICENSE.txt for license information.
// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
//
//===----------------------------------------------------------------------===//
//
// This file defines the Metal Shading Language builtin functions and the AIR
// intrinsic each one lowers to.
//
// Provenance
// ----------
// Apple's Metal standard library never implements an operation itself: every
// public API in <metal_stdlib> bottoms out in a call to a `__metal_*` builtin
// that the compiler must provide. Scanning the reference headers at
// reference-apple/clang/32023.883/include/metal finds exactly 686 such names,
// which is therefore the complete set of builtins this frontend has to declare
// for the unmodified Apple standard library to compile.
//
// Of those 686 names, 36 are the opaque handle *types* rather than functions;
// they are declared in MetalTypes.def instead. The remaining 650 functions are
// listed here.
//
// The AIR intrinsic each builtin lowers to is taken from
// research/datasets/builtin_to_air_map.v2.csv, the reference set's master
// mapping table. Every row carries its own provenance; the table reports
// 641 of 686 rows as `confirmed`, established by one or more of:
//
//   P-IR1  the intrinsic's real signature was read out of Apple's shipping
//          runtime bitcode (research/datasets/ir_air_signatures.csv, 8,194
//          declarations recovered by parsing all 701 runtime modules)
//   P-XC1  the call was observed in IR generated by Apple's compiler for a
//          probe shader (the golden corpus in research/golden)
//   P-MN1  the name follows the naming grammar derived in
//          research/spec/AIR_VOCABULARY.md
//   P-AC1  corroborated by the airconv reference implementation
//
// Naming rules worth noting, all measured rather than assumed
// (research/spec/IR_GROUND_TRUTH.md sections 6.4 to 6.10):
//   * floating point operations gain a `fast_` infix when fast math is on,
//     e.g. `air.fast_fmax3.f32`
//   * integer operations carry a `.s` or `.u` signedness suffix
//   * some names are underscore joined rather than dot separated
//     (`air.abs_diff`, `air.add_sat`, `air.mad_hi`)
//
// A small number of builtins have no AIR intrinsic at all: they lower to
// native LLVM instructions or to module scope constants. `__metal_divide` and
// `__metal_select` become `fdiv` and `select`; `__metal_get_sampler` becomes a
// module scope `@__air_sampler_state` constant plus `!air.sampler_states`
// metadata. Those rows carry an empty AIR name below and are handled
// specially in CodeGen rather than being emitted as a call.
//
// Signatures
// ----------
// Every builtin is declared as `"v."` with the "t" (custom type checking)
// attribute, the same shape upstream uses for __sync_fetch_and_add and the
// other builtins whose signature cannot be written down.
// The reference set explicitly records the precise prototypes as an open
// question (research/spec/INFO_SET.md item F-4 is marked as measured for
// vocabulary but not for typing), and this project does not invent
// specifications that its sources do not establish. Type checking is instead
// performed against the argument types at the call site, which is also what
// lets a single name such as `__metal_abs` serve every scalar and vector
// width the way the standard library expects.
//
//===----------------------------------------------------------------------===//

// Consumers that only care about declaring the builtins (Builtins.def) get a
// LANGBUILTIN gated on METAL_LANG. Consumers that need the AIR mapping (CodeGen)
// define METAL_BUILTIN themselves before including this file.
#if !defined(METAL_BUILTIN)
#if defined(LANGBUILTIN)
#define METAL_BUILTIN(ID, TYPE, ATTRS, AIRNAME)                                \
  LANGBUILTIN(ID, TYPE, ATTRS, METAL_LANG)
#else
#define METAL_BUILTIN(ID, TYPE, ATTRS, AIRNAME)
#endif
#endif

METAL_BUILTIN(__metal_abort_intersection_query, "v.", "tn", "air.abort_intersection_query.instancing.triangle_data")
