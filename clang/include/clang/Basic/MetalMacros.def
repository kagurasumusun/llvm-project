//
// This file enumerates the version independent macros that Apple's Metal
// compiler predefines for every `-x metal` translation unit.
//
// The contents are transcribed verbatim from a measurement of the reference
// toolchain (metalfe-32023.883) recorded in the metal-info reference set at
//   reference/metal-ast-macos-air64/meta/metal-predefined-macros.txt
// The version dependent macros (`__METAL__`, `__METAL_VERSION__`, `__AIR64__`,
// `__AIR32__`, `__AIR_VERSION__`, `__METAL_FAST_MATH__` and
// `__METAL_MATH_FP32_FUNCTIONS_FAST__`) are computed in AIRTargetInfo and are
// deliberately not listed here.
//
// Note that the `__HAVE_*` capability macros are NOT predefined by the
// compiler. Apple's <metal_config> header derives them from
// `__METAL_VERSION__`, so defining them here would conflict with the real
// standard library.
//
//===----------------------------------------------------------------------===//

#ifndef METAL_MACRO
#define METAL_MACRO(Name, Value)
#endif

// Note: METAL_FUNC is deliberately NOT here. It is defined by Apple's
// <metal_types> itself (`#define METAL_FUNC inline __attribute__((__always_inline__))`)
// and the reference toolchain predefines nothing of the sort (zero hits in the
// measured `cc1 -dM` output for every Metal standard). Predefining it would
// clash with the shipping standard library (different token sequence:
// `static __inline__` vs plain `inline`) and change the linkage of every
// standard library function.

METAL_MACRO("__AIR_ABI__", "__AIR_PB_ABI__")
METAL_MACRO("__AIR_MB_ABI__", "1")
METAL_MACRO("__AIR_PB_ABI__", "0")
METAL_MACRO("__AIR_VB_ABI__", "2")
METAL_MACRO("__METAL_ACCESS_READ_WRITE__", "3")
